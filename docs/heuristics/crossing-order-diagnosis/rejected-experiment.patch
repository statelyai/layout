+ * Native adaptation of ELK CrossingsCounter.countInLayerCrossingsOnPorts.
+ * SPDX-License-Identifier: EPL-2.0
+ */
+import type { GraphEdge } from "@statelyai/graph";
+import type { AcyclicOrientation, LayeredPhaseInput } from "./types";
+
+/** Count same-face arcs and edges leaving through those arcs. */
+export function countInLayerCrossings(
+  input: LayeredPhaseInput,
+  orientation: AcyclicOrientation,
+  layer: readonly string[],
+  incoming?: ReadonlyMap<string, readonly string[]>,
+  outgoing?: ReadonlyMap<string, readonly string[]>,
+): number {
+  const members = new Set(layer);
+  const nodeById = new Map(input.graph.nodes.map((node) => [node.id, node]));
+  const forward = { right: "EAST", left: "WEST", down: "SOUTH", up: "NORTH" }[input.direction];
+  const backward = { right: "WEST", left: "EAST", down: "NORTH", up: "SOUTH" }[input.direction];
+  const endpoint = (edge: GraphEdge, source: boolean) => {
+    const reversed = orientation.reversedEdgeIds.has(edge.id);
+    const authoredSource = source !== reversed;
+    const id = authoredSource ? edge.sourceId : edge.targetId;
+    const name = authoredSource ? edge.sourcePort : edge.targetPort;
+    const node = nodeById.get(id)!;
+    const port = node.ports?.find((candidate) => candidate.name === name);
+    return {
+      id,
+      key: JSON.stringify([id, name ?? `__implicit:${edge.id}:${source}`]),
+      side: port
+        ? (input.portSettings?.(port, node)?.["port.side"] ?? (source ? forward : backward))
+        : source
+          ? forward
+          : backward,
+    };
+  };
+  let crossings = 0;
+  for (const side of [forward, backward]) {
+    const positions = new Map<string, number>();
+    for (const id of layer) {
+      const selected = side === forward ? outgoing?.get(id) : incoming?.get(id);
+      const order = new Map((selected ?? []).map((edgeId, index) => [edgeId, index]));
+      const ports = new Map<string, number>();
+      for (const edge of input.graph.edges) {
+        for (const source of [true, false]) {
+          const end = endpoint(edge, source);
+          if (end.id !== id || end.side !== side) continue;
+          const rank = order.get(edge.id) ?? order.size;
+          if (!ports.has(end.key)) ports.set(end.key, rank);
+        }
+      }
+      const ordered = [...ports].sort((a, b) => (side === forward ? a[1] - b[1] : b[1] - a[1]));
+      for (const [key] of ordered) positions.set(key, positions.size);
+    }
+    const arcs: Array<readonly [number, number]> = [];
+    const through: number[] = [];
+    for (const edge of input.graph.edges) {
+      const source = endpoint(edge, true),
+        target = endpoint(edge, false);
+      if (source.id === target.id) continue;
+      const a = positions.get(source.key),
+        b = positions.get(target.key);
+      if (members.has(source.id) && members.has(target.id)) {
+        if (a !== undefined && b !== undefined && a !== b)
+          arcs.push([Math.min(a, b), Math.max(a, b)]);
+      } else {
+        if (a !== undefined) through.push(a);
+        if (b !== undefined) through.push(b);
+      }
+    }
+    for (let i = 0; i < arcs.length; i++) {
+      const [a, b] = arcs[i]!;
+      for (const point of through) if (a < point && point < b) crossings++;
+      for (const [c, d] of arcs.slice(i + 1)) {
+        if ((a < c && c < b && b < d) || (c < a && a < d && d < b)) crossings++;
+      }
+    }
+  }
+  return crossings;
+}
+
