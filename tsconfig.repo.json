{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom"],
    "noUncheckedIndexedAccess": false,
    "allowImportingTsExtensions": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "noUnusedLocals": false
  },
  "include": ["*.ts", "bench/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
